{
  "name": "prototxt-parser",
  "version": "0.1.5",
  "description": "a prototxt parser for js based on parsimmon",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "unpkg": "dist/browser/prototxt-parser.min.js",
  "scripts": {
    "build": "tsc && gulp build:browser",
    "build:src": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "build:browser": "gulp build:browser",
    "test": "npm run build:test && jasmine --config=jasmine.json",
    "test:watch": "npm run build:test && jasmine --config=jasmine.json --watch",
    "test-travis": "npm run build:test && jasmine --config=jasmine.json",
    "publish-npm": "npm install && npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaosmail/prototxt-parser.git"
  },
  "keywords": [
    "caffe",
    "prototxt",
    "parser"
  ],
  "author": "Christoph Koerner",
  "license": "MIT",
  "devDependencies": {
    "@types/jasmine": "^2.8.23",
    "@types/parsimmon": "^1.3.1",
    "browserify": "~14.4.0",
    "del": "^3.0.0",
    "gulp": "^5.0.1",
    "gulp-rename": "^1.2.2",
    "gulp-typescript": "^6.0.0-alpha.1",
    "jasmine": "^5.12.0",
    "jasmine-core": "~2.6.4",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^2.2.0",
    "karma-firefox-launcher": "^1.0.1",
    "karma-jasmine": "~1.1.0",
    "karma-phantomjs-launcher": "^1.0.4",
    "karma-typescript": "^5.5.4",
    "run-sequence": "^2.2.0",
    "tinyify": "^2.3.0",
    "tsify": "~3.0.1",
    "tslint": "~5.6.0",
    "tslint-no-circular-imports": "~0.2.0",
    "typescript": "^3.9.10",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0"
  },
  "dependencies": {
    "parsimmon": "^1.6.2"
  }
}
